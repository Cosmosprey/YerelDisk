<Window x:Class="YerelDisk.Wpf.ReferenceLibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="YerelDisk · Son referanslar" Width="610" Height="510" MinWidth="470" MinHeight="410"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Canvas}" Foreground="{DynamicResource Ink}" FontFamily="Segoe UI" FontSize="13">
  <Grid Margin="16">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,10">
      <TextBlock Text="Son referanslar" FontSize="22" FontWeight="SemiBold" />
      <TextBlock Text="Başarıyla kaydedilen veya karşılaştırılan son 10 referans." Style="{StaticResource MutedText}" TextWrapping="Wrap" />
    </StackPanel>
    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="10" Margin="0,0,0,10">
      <StackPanel>
        <TextBlock x:Name="FolderLabel" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
        <WrapPanel Margin="0,4,0,0">
          <Button Content="Kayıt klasörü seç…" Click="ChooseFolder" Margin="0,0,6,0" />
          <Button x:Name="ClearFolderButton" Content="Klasör seçimini temizle" Click="ClearFolder" />
        </WrapPanel>
        <CheckBox x:Name="RememberOption" Content="Bu bilgisayarda hatırla" Click="RememberChanged" />
        <TextBlock Text="Açıkken referans yolları ve klasör tercihi yerelde saklanır." Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" />
        <TextBlock x:Name="LibraryFeedback" TextWrapping="Wrap" />
      </StackPanel>
    </Border>
    <Grid Grid.Row="2">
      <ListBox x:Name="References" SelectionChanged="ReferenceSelected" AutomationProperties.Name="Son referanslar">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <StackPanel Margin="3,2" ToolTip="{Binding Path}">
              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding DateText}" Foreground="{DynamicResource Muted}" />
                <TextBlock Text=" · " Foreground="{DynamicResource Muted}" />
                <TextBlock Text="{Binding SizeText}" Foreground="{DynamicResource Muted}" />
              </StackPanel>
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <TextBlock x:Name="EmptyLibrary" Text="Henüz son referans yok." Style="{StaticResource MutedText}"
                 HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
    </Grid>
    <WrapPanel Grid.Row="3" Margin="0,10,0,0">
      <Button x:Name="CompareButton" Content="Seçiliyle karşılaştır" Style="{StaticResource Primary}" Click="Compare" Margin="0,0,6,4" />
      <Button x:Name="RemoveButton" Content="Listeden çıkar" Click="Remove" Margin="0,0,6,4" />
      <Button Content="Kapat" IsCancel="True" Margin="0,0,0,4" />
    </WrapPanel>
  </Grid>
</Window>
