<Window x:Class="YerelDisk.Wpf.ProfilesWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="YerelDisk · Tarama profilleri" Width="820" Height="720" MinWidth="660" MinHeight="600" FontFamily="Segoe UI" FontSize="13"
        Background="{DynamicResource Canvas}" Foreground="{DynamicResource Ink}" WindowStartupLocation="CenterOwner" Closing="WindowClosing">
  <Grid Margin="16">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,10"><TextBlock Text="Tarama profilleri" FontSize="24" FontWeight="SemiBold"/>
      <TextBlock Text="Seçili kökleri ve hariç tutmaları bir adla tekrar kullanın. Profil seçmek tarama başlatmaz." Style="{StaticResource MutedText}" Margin="0,4,0,0"/>
    </StackPanel>
    <DataGrid Grid.Row="1" x:Name="ProfileList" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionChanged="ProfileSelected" RowHeight="34" ColumnHeaderHeight="36" CanUserSortColumns="False" AutomationProperties.Name="Kayıtlı tarama kapsamları">
      <DataGrid.Columns><DataGridTextColumn Header="Profil" Binding="{Binding Name}" Width="*" MinWidth="170"/><DataGridTextColumn Header="Kapsam" Binding="{Binding ScopeText}" Width="190"/></DataGrid.Columns>
    </DataGrid>
    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="8" Margin="0,6,0,6">
      <ScrollViewer MaxHeight="60" VerticalScrollBarVisibility="Auto"><TextBox x:Name="SelectedScope" IsReadOnly="True" TextWrapping="Wrap" Background="Transparent" BorderThickness="0" Padding="0" FontSize="12" AutomationProperties.Name="Seçili profilin kökleri ve hariç yolları"/></ScrollViewer>
    </Border>
    <StackPanel Grid.Row="3" x:Name="EditActions">
      <TextBlock x:Name="CurrentScope" Style="{StaticResource MutedText}" FontSize="12"/>
      <DockPanel Margin="0,6,0,6"><TextBlock Text="Profil adı" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBox x:Name="NameInput" MaxLength="80" AutomationProperties.Name="Tarama profili adı"/></DockPanel>
      <WrapPanel x:Name="NormalActions" Margin="0,0,0,8"><Button x:Name="SaveButton" Content="Yeni profil ekle" Click="SaveNew" Margin="0,0,6,4"/><Button x:Name="UpdateButton" Content="Seçili profili güncelle" Click="UpdateSelected" Margin="0,0,6,4"/><Button x:Name="RemoveButton" Content="Profili kaldır" Click="RemoveSelected" Margin="0,0,0,4" ToolTip="Yalnız profil kaydı kaldırılır; dosya ve klasörlere dokunulmaz."/></WrapPanel>
      <WrapPanel x:Name="ConflictActions" Visibility="Collapsed" Margin="0,0,0,8"><Button x:Name="CopyConflictButton" Content="Ayrı profil olarak kaydet" Click="CopyConflict" Margin="0,0,6,4" ToolTip="Oturumdaki düzenlemeyi yukarıdaki adla ayrı kaydeder; diğer pencerenin profilini korur."/><Button x:Name="UseSavedButton" Content="Diskteki sürümü kullan" Click="UseSavedConflict" Margin="0,0,0,4" ToolTip="Yalnız çakışan düzenleme bırakılır; diğer bekleyen değişiklikler korunur."/></WrapPanel>
    </StackPanel>
    <StackPanel Grid.Row="4" Margin="0,0,0,8">
      <CheckBox x:Name="RememberOption" Content="Profilleri bu bilgisayarda hatırla" Checked="RememberChanged" Unchecked="RememberChanged"/>
      <TextBlock Text="Kapalıyken liste yalnız bu oturumda kalır. Açılırsa adlar ve yollar yerel uygulama verisindeki YerelDisk-profiller.json dosyasında saklanır. Kapatmak kayıt dosyasını kaldırır; oturumdaki liste korunur." Style="{StaticResource MutedText}" FontSize="11" Margin="0,5,0,0"/>
    </StackPanel>
    <StackPanel Grid.Row="5">
      <ScrollViewer MaxHeight="60" VerticalScrollBarVisibility="Auto"><TextBlock x:Name="Feedback" TextWrapping="Wrap" FontSize="12"/></ScrollViewer>
      <DockPanel Margin="0,8,0,0"><Button Content="Kapat" IsCancel="True" DockPanel.Dock="Right" Margin="8,0,0,0"/><Button x:Name="UseButton" Content="Seçili profili kullan" Click="UseSelected" FontWeight="SemiBold" BorderBrush="{DynamicResource Accent}" DockPanel.Dock="Right"/>
        <TextBlock Text="Tarama başlamaz. Yolları seçim ekranında düzenleyebilirsiniz." Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,8,0"/>
      </DockPanel>
    </StackPanel>
  </Grid>
</Window>
