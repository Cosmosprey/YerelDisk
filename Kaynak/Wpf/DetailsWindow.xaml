<Window x:Class="YerelDisk.Wpf.DetailsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:YerelDisk.Wpf"
        Title="YerelDisk · Tam ayrıntı" Width="800" Height="720" MinWidth="540" MinHeight="400" WindowStartupLocation="CenterOwner" Background="{DynamicResource Canvas}" Foreground="{DynamicResource Ink}" FontFamily="Segoe UI" FontSize="13" PreviewKeyDown="WindowKeyDown">
  <Grid Background="{DynamicResource Canvas}"><DockPanel Margin="24">
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,15"><TextBlock Text="{Binding Title}" FontSize="23" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" /><TextBlock Text="{Binding Summary}" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" MaxHeight="40" ToolTip="{Binding Summary}" Margin="0,7,0,4" /><TextBox x:Name="DetailPath" Text="{Binding Path, Mode=OneWay}" IsReadOnly="True" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" MaxHeight="42" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource Muted}" Padding="0" AutomationProperties.Name="Seçimin tam yolu; yatay kaydırılabilir ve kopyalanabilir" /></StackPanel>
    <DockPanel DockPanel.Dock="Bottom" Margin="0,14,0,0"><Button Content="Tam metni kopyala" Click="CopyText" DockPanel.Dock="Left" /><Button Content="Kapat · Esc" Click="CloseWindow" DockPanel.Dock="Right" Margin="10,0,0,0" /><TextBlock x:Name="CopyState" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" MaxHeight="40" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" VerticalAlignment="Center" Margin="10,0,10,0" /></DockPanel>
    <Border Style="{StaticResource Card}" Padding="20"><ScrollViewer x:Name="DetailScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><local:DetailsContent x:Name="ContentView" /></ScrollViewer></Border>
  </DockPanel></Grid>
</Window>
