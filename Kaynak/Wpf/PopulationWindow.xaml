<Window x:Class="YerelDisk.Wpf.PopulationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="YerelDisk · Dosya yapısı" Width="940" Height="720" MinWidth="680" MinHeight="580"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource Canvas}" Foreground="{DynamicResource Ink}"
        FontFamily="Segoe UI" FontSize="13">
  <Window.Resources>
    <Style TargetType="TabItem">
      <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
      <Setter Property="Background" Value="{DynamicResource Soft}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
      <Setter Property="Padding" Value="12,7"/><Setter Property="Margin" Value="0,0,6,6"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
        <Border x:Name="TabBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}">
          <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsSelected" Value="True"><Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource Selection}"/><Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource Accent}"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource Accent}"/><Setter TargetName="TabBorder" Property="BorderThickness" Value="2"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>
  <Grid Margin="16">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel>
      <TextBlock x:Name="Heading" Text="Dosya yapısı" FontSize="24" FontWeight="SemiBold"/>
      <TextBlock x:Name="Location" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Style="{StaticResource MutedText}" Margin="0,4,0,5"/>
      <TextBlock x:Name="Explanation" Text="Mevcut tarama özetleri hazırlanıyor…" TextWrapping="Wrap"/>
    </StackPanel>
    <Grid Grid.Row="1" Margin="0,10,0,8">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Style="{StaticResource Card}" Padding="12"><StackPanel><TextBlock Text="ANALİZ EDİLEN DOSYA ADI" Style="{StaticResource MutedText}" FontSize="10"/><TextBlock x:Name="TotalCount" Text="—" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel></Border>
      <Border Grid.Column="1" Style="{StaticResource Card}" Padding="12" Margin="6,0"><StackPanel><TextBlock Text="0–4 KiB · 0 BAYT DAHİL" Style="{StaticResource MutedText}" FontSize="10"/><TextBlock x:Name="SmallCount" Text="—" FontSize="18" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel></Border>
      <Border Grid.Column="2" Style="{StaticResource Card}" Padding="12"><StackPanel><TextBlock Text="0 BAYTLIK DOSYA" Style="{StaticResource MutedText}" FontSize="10"/><TextBlock x:Name="EmptyCount" Text="—" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel></Border>
    </Grid>
    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" MaxHeight="70" Margin="0,0,0,8">
      <TextBlock x:Name="Coverage" TextWrapping="Wrap" FontSize="12"/>
    </ScrollViewer>
    <TabControl Grid.Row="3" x:Name="AnalysisTabs" IsEnabled="False" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" Foreground="{DynamicResource Ink}">
      <TabItem Header="Uzantılara göre">
        <DataGrid x:Name="TypesGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserSortColumns="False" RowHeight="34" ColumnHeaderHeight="36" SelectionMode="Single" AutomationProperties.Name="Dosya adlarına göre uzantı dağılımı">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Uzantı / grup" Binding="{Binding Extension}" Width="*" MinWidth="175"/>
            <DataGridTextColumn Header="Dosya" Binding="{Binding CountText}" Width="100"/>
            <DataGridTextColumn Header="Sayı payı" Binding="{Binding ShareText}" Width="85"/>
            <DataGridTextColumn Header="Boyut" Binding="{Binding SizeText}" Width="110"/>
          </DataGrid.Columns>
        </DataGrid>
      </TabItem>
      <TabItem Header="Sayıyı artıran alanlar">
        <DataGrid x:Name="AreasGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserSortColumns="False" RowHeight="34" ColumnHeaderHeight="36" SelectionMode="Single" AutomationProperties.Name="Alt klasörlere göre dosya sayısı">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Alan" Binding="{Binding Name}" Width="*" MinWidth="175">
              <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="ToolTip" Value="{Binding Path}"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="6,0"/></Style></DataGridTextColumn.ElementStyle>
            </DataGridTextColumn>
            <DataGridTextColumn Header="Analiz edilen" Binding="{Binding CountText}" Width="140"/>
            <DataGridTextColumn Header="Sayı payı" Binding="{Binding ShareText}" Width="85"/>
            <DataGridTextColumn Header="Boyut" Binding="{Binding SizeText}" Width="110"/>
          </DataGrid.Columns>
        </DataGrid>
      </TabItem>
    </TabControl>
    <DockPanel Grid.Row="4" Margin="0,10,0,0">
      <Button x:Name="CloseButton" Content="Kapat" IsCancel="True" DockPanel.Dock="Right" VerticalAlignment="Bottom" Margin="12,0,0,0"/>
      <TextBlock x:Name="Limits" Style="{StaticResource MutedText}" FontSize="11"/>
    </DockPanel>
  </Grid>
</Window>
