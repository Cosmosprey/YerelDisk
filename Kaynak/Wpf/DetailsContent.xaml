<UserControl x:Class="YerelDisk.Wpf.DetailsContent" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Foreground="{DynamicResource Ink}">
  <ItemsControl ItemsSource="{Binding Sections}">
    <ItemsControl.ItemTemplate><DataTemplate>
      <Border Margin="0,0,0,14">
        <Border.Style><Style TargetType="Border"><Setter Property="Padding" Value="0" /><Setter Property="CornerRadius" Value="7" /><Style.Triggers><DataTrigger Binding="{Binding Caution}" Value="True"><Setter Property="Padding" Value="12" /><Setter Property="Background" Value="{DynamicResource WarningSurface}" /><Setter Property="BorderBrush" Value="{DynamicResource WarningLine}" /><Setter Property="BorderThickness" Value="1" /></DataTrigger></Style.Triggers></Style></Border.Style>
        <StackPanel><TextBlock Text="{Binding Heading}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,6" /><TextBox Text="{Binding Text, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" Padding="0" FontSize="12" /></StackPanel>
      </Border>
    </DataTemplate></ItemsControl.ItemTemplate>
  </ItemsControl>
</UserControl>
