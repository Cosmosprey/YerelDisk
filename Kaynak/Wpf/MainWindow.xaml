<Window x:Class="YerelDisk.Wpf.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:YerelDisk.Wpf"
        Title="YerelDisk 1.18.0" Width="1480" Height="940" MinWidth="940" MinHeight="680" WindowStyle="SingleBorderWindow" ResizeMode="CanResize" Background="{DynamicResource Canvas}" Foreground="{DynamicResource Ink}" FontFamily="Segoe UI" FontSize="13" WindowStartupLocation="CenterScreen" SizeChanged="WindowSizeChanged" Closing="WindowClosing" PreviewKeyDown="WindowKeyDown" KeyDown="WindowKeyDownAfterControls">
  <Grid Background="{DynamicResource Canvas}">
    <Grid.ColumnDefinitions><ColumnDefinition Width="196" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
    <Border Background="{DynamicResource Side}">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Top" Margin="24,29,12,26">
          <StackPanel Orientation="Horizontal"><TextBlock Text="◫" FontSize="30" Foreground="#9DADFF" Margin="0,0,10,0" /><TextBlock Text="YerelDisk" FontSize="23" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" /></StackPanel>
          <TextBlock Text="ALANI ANLAYIN" Foreground="{StaticResource SideMuted}" FontSize="10" Margin="0,9,0,0" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="18,10,18,24">
          <Button Content="Koyu / açık tema" Click="ToggleTheme" Background="#243452" BorderThickness="0" Foreground="#DAE2F3" Padding="8" />
          <TextBlock Text="Yalnızca bu bilgisayarda" Foreground="{StaticResource SideMuted}" FontSize="11" Margin="4,16,0,3" />
          <TextBlock Text="Ağ ve telemetri yok" Foreground="{StaticResource SideMuted}" FontSize="11" Margin="4,0,0,0" />
        </StackPanel>
        <StackPanel>
          <TextBlock Text="ÇALIŞMA ALANI" Foreground="{StaticResource SideMuted}" FontSize="10" Margin="26,3,0,13" />
          <RadioButton x:Name="FoldersNav" GroupName="Navigation" Style="{StaticResource Nav}" Content="▤   Klasörler" Tag="Folders" IsChecked="True" Click="Navigate" />
          <RadioButton x:Name="FilesNav" GroupName="Navigation" Style="{StaticResource Nav}" Content="▥   Büyük dosyalar" Tag="Files" Click="Navigate" />
          <RadioButton x:Name="ReviewNav" GroupName="Navigation" Style="{StaticResource Nav}" Content="◇   İnceleme adayları" Tag="Review" Click="Navigate" />
          <RadioButton x:Name="IssuesNav" GroupName="Navigation" Style="{StaticResource Nav}" Content="△   Uyarılar" Tag="Issues" Click="Navigate" />
          <Border Height="1" Background="#30405D" Margin="24,18" />
          <RadioButton x:Name="SettingsNav" GroupName="Navigation" Style="{StaticResource Nav}" Content="⚙   Ayarlar" Tag="Settings" Click="Navigate" />
          <Border CornerRadius="8" Background="#202E4A" Padding="13" Margin="18,28,18,0"><TextBlock Text="YERELDİSK&#10;Sürüm 1.18.0" Foreground="{StaticResource SideMuted}" FontSize="11" LineHeight="20" /></Border>
        </StackPanel>
      </DockPanel>
    </Border>
    <Grid Grid.Column="1" Margin="26,24,26,18">
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <Grid x:Name="PageHeader" Margin="0,0,0,20">
        <Grid.Style><Style TargetType="Grid"><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True" /><Condition Binding="{Binding IsDistribution}" Value="True" /></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Collapsed" /></MultiDataTrigger></Style.Triggers></Style></Grid.Style>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="{Binding Title}" FontSize="25" FontWeight="SemiBold" /><TextBlock Text="{Binding Subtitle}" Style="{StaticResource MutedText}" Margin="0,7,12,0" /></StackPanel>
        <Border Grid.Column="1" Background="{DynamicResource Selection}" CornerRadius="20" Padding="13,7" VerticalAlignment="Top" Margin="8,0,0,0"><TextBlock Text="YEREL · ÇEVRİMDIŞI" Foreground="{DynamicResource Accent}" FontSize="10" FontWeight="SemiBold" /></Border>
      </Grid>
      <Border x:Name="ScopeCard" Grid.Row="1" Style="{StaticResource Card}" Padding="18,15" Margin="0,0,0,16">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center" Margin="0,0,12,0"><TextBlock Text="TARANACAK KONUMLAR" Foreground="{DynamicResource Muted}" FontSize="10" FontWeight="SemiBold" /><TextBlock Text="{Binding RootsLabel}" TextTrimming="CharacterEllipsis" ToolTip="{Binding RootsLabel}" FontSize="14" Margin="0,7,0,0" /></StackPanel>
          <WrapPanel Grid.Column="1" VerticalAlignment="Center">
            <Button x:Name="ChooseButton" Content="Klasörleri seç" IsEnabled="{Binding CanConfigure}" Click="ChooseRoots" Margin="0,0,8,0" ToolTip="Birden fazla kök seçebilir, alt klasörleri hariç tutabilir veya elle yol ekleyebilirsiniz." />
            <Button x:Name="ScanButton" Content="{Binding ScanActionLabel}" IsEnabled="{Binding CanScan}" Style="{StaticResource Primary}" Click="StartScan" ToolTip="İlk ölçümden sonra üstveri doğrulanır. Değişen klasörler en fazla iki kez hedefli yenilenir. Doğrulama paralel çalışır; belirsiz alanlar gizlenmez." />
            <Button Content="Durdur" IsEnabled="{Binding CanStop}" Click="StopScan" Margin="8,0,0,0" />
          </WrapPanel>
        </Grid>
      </Border>
      <Grid x:Name="Metrics" Grid.Row="2" Margin="0,0,0,18">
        <Grid.Style>
          <Style TargetType="Grid">
            <Setter Property="Visibility" Value="{Binding ShowMetrics, Converter={StaticResource Visible}}" />
            <Style.Triggers>
              <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                  <Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True" />
                  <Condition Binding="{Binding IsExpanded, ElementName=SummaryExpander}" Value="True" />
                  <Condition Binding="{Binding ShowSummary}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Visibility" Value="Collapsed" />
              </MultiDataTrigger>
            </Style.Triggers>
          </Style>
        </Grid.Style>
        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
        <Border Style="{StaticResource Card}" Padding="18,15" Margin="0,0,6,0"><StackPanel><TextBlock Text="BOYUT TOPLAMI" Foreground="{DynamicResource Muted}" FontSize="10" /><TextBlock Text="{Binding LogicalSize}" FontSize="28" FontWeight="SemiBold" Margin="0,6,0,2" /><TextBlock Text="Taranan veri akışları" Style="{StaticResource MutedText}" FontSize="11" /></StackPanel></Border>
        <Border Grid.Column="1" Style="{StaticResource Card}" Padding="18,15" Margin="6,0,6,0"><StackPanel><TextBlock Text="ÖLÇÜLEN AYRILAN ALAN" Foreground="{DynamicResource Muted}" FontSize="10" /><TextBlock Text="{Binding AllocatedSize}" FontSize="28" FontWeight="SemiBold" Margin="0,6,0,2" /><TextBlock Text="Silinebilir alan garantisi değil" Style="{StaticResource MutedText}" FontSize="11" /></StackPanel></Border>
        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="18,15" Margin="6,0,0,0"><StackPanel><TextBlock Text="DOSYA SAYISI" Foreground="{DynamicResource Muted}" FontSize="10" /><TextBlock Text="{Binding FileCount}" FontSize="28" FontWeight="SemiBold" Margin="0,6,0,2" /><TextBlock Text="Liste sınırından bağımsız" Style="{StaticResource MutedText}" FontSize="11" /></StackPanel></Border>
      </Grid>
      <StackPanel Grid.Row="3">
        <Border x:Name="SummaryCard" Style="{StaticResource Card}" Padding="10,7" Margin="0,0,0,10" Visibility="{Binding ShowSummary, Converter={StaticResource Visible}}">
          <Expander x:Name="SummaryExpander" Foreground="{DynamicResource Ink}" IsExpanded="False" AutomationProperties.Name="Tarama özeti">
            <Expander.Header><TextBlock Text="{Binding Summary.Heading}" TextWrapping="Wrap" FontSize="12" FontWeight="SemiBold" /></Expander.Header>
            <ScrollViewer x:Name="SummaryScroll" MaxHeight="140" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="8,8,4,2">
              <StackPanel>
                <TextBlock Text="{Binding Summary.Totals}" TextWrapping="Wrap" FontSize="12" />
                <TextBlock Text="{Binding Summary.Coverage}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,5,0,0" />
                <TextBlock Text="{Binding Summary.Timing}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,5,0,0" />
                <TextBlock Text="{Binding Summary.Limits}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,5,0,0" />
              </StackPanel>
            </ScrollViewer>
          </Expander>
        </Border>
        <Border Background="{DynamicResource Selection}" CornerRadius="7" Padding="12,8" Margin="0,0,0,10" Visibility="{Binding HasError, Converter={StaticResource Visible}}"><TextBlock Text="{Binding Error}" TextWrapping="Wrap" /></Border>
        <Border x:Name="ScopeNoticeCard" Background="{DynamicResource WarningSurface}" BorderBrush="{DynamicResource WarningLine}" BorderThickness="1" CornerRadius="7" Padding="12,8" Margin="0,0,0,10">
          <Border.Style>
            <Style TargetType="Border">
              <Setter Property="Visibility" Value="{Binding ShowScopeNotice, Converter={StaticResource Visible}}" />
              <Style.Triggers>
                <MultiDataTrigger>
                  <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsExpanded, ElementName=SummaryExpander}" Value="True" />
                    <Condition Binding="{Binding ShowSummary}" Value="True" />
                  </MultiDataTrigger.Conditions>
                  <Setter Property="Visibility" Value="Collapsed" />
                </MultiDataTrigger>
              </Style.Triggers>
            </Style>
          </Border.Style>
          <TextBlock x:Name="ScopeNoticeText" TextWrapping="Wrap" ToolTip="{Binding ScopeText}" FontSize="11">
            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="{Binding ScopeNotice}" /><Style.Triggers><DataTrigger Binding="{Binding Tag, ElementName=ScopeNoticeCard}" Value="True"><Setter Property="Text" Value="{Binding CompactScopeNotice}" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
          </TextBlock>
        </Border>
      </StackPanel>
      <Grid Grid.Row="4">
        <Grid x:Name="ResultsArea" Visibility="{Binding IsResults, Converter={StaticResource Visible}}">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
          <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Button Content="↑" Click="GoUp" IsEnabled="{Binding CanGoUp}" Margin="0,0,8,0" ToolTip="Üst klasöre dön (Alt+Yukarı)" />
            <Border Grid.Column="1" Style="{StaticResource Card}" CornerRadius="7" Padding="1" IsEnabled="{Binding CanSearch}">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBox x:Name="SearchBox" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" TextChanged="SearchChanged" BorderThickness="0" Background="Transparent" Padding="12,8" VerticalContentAlignment="Center" AutomationProperties.Name="Sonuçlarda ara" />
                <TextBlock Text="Bu görünümde ara…  Ctrl+F" IsHitTestVisible="False" Foreground="{DynamicResource Muted}" Margin="12,0,0,0" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Search}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                <Button Grid.Column="1" Content="×" Click="ClearSearch" Background="Transparent" BorderThickness="0" Padding="12,3" ToolTip="Aramayı temizle" />
              </Grid>
            </Border>
            <StackPanel Grid.Column="2" Orientation="Horizontal"><Button Content="Ayrıntı · F6" Click="ShowDetails" IsEnabled="{Binding CanSearch}" Margin="8,0,0,0" /><Button Content="CSV kaydet" IsEnabled="{Binding CanExport}" Click="Export" Margin="8,0,0,0" ToolTip="Yalnız görünür listedeki kayıtları ve uygulanan filtreleri kaydeder." /></StackPanel>
          </Grid>
          <StackPanel Grid.Row="1" Margin="0,0,0,10">
            <Grid x:Name="ResultsPathRow" Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock Text="{Binding FolderPath}" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" ToolTip="{Binding FolderPath}" Margin="1,0,12,0" VerticalAlignment="Center" />
            <WrapPanel Grid.Column="1" Visibility="{Binding IsFolderView, Converter={StaticResource Visible}}" IsEnabled="{Binding CanSwitchPresentation}">
              <Button x:Name="TableModeButton" Content="Tablo" Click="ShowTable" Padding="12,5" MinHeight="30" Margin="0,0,6,0"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding ShowTable}" Value="True"><Setter Property="Background" Value="{DynamicResource Selection}" /><Setter Property="BorderBrush" Value="{DynamicResource Accent}" /></DataTrigger></Style.Triggers></Style></Button.Style></Button>
              <Button x:Name="DistributionModeButton" Content="Alan dağılımı" Click="ShowDistribution" Padding="12,5" MinHeight="30" ToolTip="En büyük alt klasörleri çubuklarla karşılaştırın. Mantıksal boyut; silinebilir alan değildir."><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding IsDistribution}" Value="True"><Setter Property="Background" Value="{DynamicResource Selection}" /><Setter Property="BorderBrush" Value="{DynamicResource Accent}" /></DataTrigger></Style.Triggers></Style></Button.Style></Button>
            </WrapPanel>
            </Grid>
            <WrapPanel x:Name="CompactSelectionActions" Visibility="Collapsed" Margin="0,0,0,10">
              <Button Content="Konumu aç" Click="OpenLocation" IsEnabled="{Binding CanUseSelection}" Padding="10,7" Margin="0,0,6,0" />
              <Button Content="Yolu kopyala" Click="CopyPath" IsEnabled="{Binding CanUseSelection}" Padding="10,7" Margin="0,0,12,0" />
              <StackPanel Orientation="Horizontal" Visibility="{Binding IsKnownReview, Converter={StaticResource Visible}}" IsEnabled="{Binding CanUseSelection}">
                <TextBlock Text="Kişisel not" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox ItemsSource="{Binding FeedbackChoices}" SelectedItem="{Binding Feedback}" Width="190" AutomationProperties.Name="Oturumluk kişisel aday notu" ToolTip="Bu işaretler kuralları eğitmez ve silme izni vermez." />
              </StackPanel>
            </WrapPanel>
            <WrapPanel Visibility="{Binding IsReview, Converter={StaticResource Visible}}">
              <ComboBox x:Name="ReviewCollectionSelector" ItemsSource="{Binding ReviewCollectionChoices}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding ReviewCollection, Mode=OneWay}" SelectionChanged="ReviewCollectionChanged" IsEnabled="{Binding CanSearch}" Width="210" Margin="0,0,8,0" AutomationProperties.Name="İnceleme listesi" ToolTip="Kural eşleşmeleri veya amacı tanınmayan diğer büyük alanlar. İkisi de silme izni değildir." />
              <ComboBox x:Name="ReviewMinimumSelector" ItemsSource="{Binding MinimumChoices}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding ReviewMinimum}" SelectionChanged="ReviewFilterChanged" Width="160" Margin="0,0,8,0" AutomationProperties.Name="Aday boyut eşiği" />
              <ComboBox x:Name="ReviewKindSelector" ItemsSource="{Binding KindChoices}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding ReviewKindFilter}" SelectionChanged="ReviewFilterChanged" Width="205" Visibility="{Binding IsKnownReview, Converter={StaticResource Visible}}" AutomationProperties.Name="Aday türü" />
            </WrapPanel>
          </StackPanel>
          <Grid x:Name="Workspace" Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="310" /></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="0" /><RowDefinition Height="0" /></Grid.RowDefinitions>
            <Border x:Name="TableCard" Style="{StaticResource Card}" ClipToBounds="True">
              <Grid><Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <DataGrid x:Name="ResultsGrid" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow, Mode=TwoWay}" Sorting="SortResults" MouseDoubleClick="ResultDoubleClick" PreviewKeyDown="ResultsKeyDown" Margin="1,3,1,0" AutomationProperties.Name="Tarama sonuçları" Visibility="{Binding ShowTable, Converter={StaticResource Visible}}" />
                <local:DistributionView x:Name="DistributionChart" Visibility="{Binding IsDistribution, Converter={StaticResource Visible}}" />
                <TextBlock Text="{Binding EmptyMessage}" TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource Muted}" Margin="32,65,32,20" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="430" IsHitTestVisible="False">
                  <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsEmpty}" Value="True" /><Condition Binding="{Binding ShowTable}" Value="True" /></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible" /></MultiDataTrigger></Style.Triggers></Style></TextBlock.Style>
                </TextBlock>
                <Border Grid.Row="1" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="13,5" MinHeight="32"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding ListCaption}" Foreground="{DynamicResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding ListCaptionDetail}" VerticalAlignment="Center" />
                  <Button x:Name="ClearReviewFiltersButton" Grid.Column="1" Content="Filtreleri temizle" Click="ClearReviewFilters" Visibility="{Binding HasReviewFilters, Converter={StaticResource Visible}}" IsEnabled="{Binding CanClearReviewFilters}" Margin="8,0,0,0" Padding="8,2" MinHeight="22" FontSize="11" ToolTip="Bu inceleme listesinin aramasını ve boyut eşiğini kaldırır; kural eşleşmelerinde tür filtresini de temizler. Tarama kapsamı değişmez." />
                </Grid></Border>
              </Grid>
            </Border>
            <GridSplitter x:Name="DetailSplitter" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent" ResizeBehavior="PreviousAndNext" ResizeDirection="Columns" />
            <Border x:Name="DetailsCard" Grid.Column="2" Style="{StaticResource Card}" Padding="18">
              <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top"><TextBlock Text="SEÇİM AYRINTILARI" Foreground="{DynamicResource Muted}" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,8" /><TextBlock Text="{Binding Details.Title}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" MaxHeight="45" ToolTip="{Binding Details.Title}" /><TextBlock Text="{Binding Details.Path}" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,6,0,7" TextTrimming="CharacterEllipsis" ToolTip="{Binding Details.Path}" /><TextBlock Text="{Binding Details.Summary}" FontWeight="SemiBold" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,14" /></StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                  <WrapPanel><Button Content="Konumu aç" Click="OpenLocation" IsEnabled="{Binding CanUseSelection}" Padding="10,7" Margin="0,0,6,0" /><Button Content="Yolu kopyala" Click="CopyPath" IsEnabled="{Binding CanUseSelection}" Padding="10,7" /></WrapPanel>
                </StackPanel>
                <ScrollViewer x:Name="SelectionScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
                  <local:DetailsContent x:Name="SelectionContent" DataContext="{Binding Details}" />
                  <StackPanel Visibility="{Binding IsKnownReview, Converter={StaticResource Visible}}" IsEnabled="{Binding CanUseSelection}" Margin="0,3,0,10"><TextBlock Text="Oturumluk kişisel not" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,0,0,5" /><ComboBox ItemsSource="{Binding FeedbackChoices}" SelectedItem="{Binding Feedback}" ToolTip="Bu işaretler kuralları eğitmez ve silme izni vermez." /></StackPanel>
                </StackPanel></ScrollViewer>
              </DockPanel>
            </Border>
          </Grid>
        </Grid>
        <ScrollViewer Visibility="{Binding IsSettings, Converter={StaticResource Visible}}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel MaxWidth="830" HorizontalAlignment="Left">
            <Border Style="{StaticResource Card}" Padding="23" Margin="0,0,0,14"><StackPanel>
              <TextBlock Text="Uygulama kayıtları · isteğe bağlı" FontSize="18" FontWeight="SemiBold" />
              <TextBlock Text="Düğmeye bastığınızda Windows'un HKLM/HKCU Uninstall 32/64 kayıtlarındaki uygulama adı, yayıncı, sürüm ve bildirilen kurulum yolu yerelde okunur. Seçilen disk klasörlerinin dışındaki kayıtlar da incelenebilir. Dosya içerikleri ve çalışan süreçler okunmaz; ağ ve otomatik kayıt yoktur." Style="{StaticResource MutedText}" Margin="0,10,0,0" />
              <TextBlock Text="Yalnız taranan yolla kayıt ilişkisi aranır. Uygulamanın hâlâ kurulu / aktif olduğu veya dosyanın gereksizliği belirlenmez. Önce disk taraması yapın; ipuçları yeni taramada bırakılır." Style="{StaticResource MutedText}" Margin="0,7,0,0" />
              <WrapPanel Margin="0,12,0,0"><Button x:Name="InspectInventoryButton" Content="Uygulama kayıtlarını incele" Click="InspectInventory" IsEnabled="{Binding Inventory.CanInspect}" Margin="0,0,8,0" /><Button Content="Durdur / ipuçlarını bırak" Click="ForgetInventory" IsEnabled="{Binding Inventory.CanForget}" /></WrapPanel>
              <TextBlock Text="{Binding Inventory.Status}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,12,0,0" />
              <TextBlock Text="{Binding Inventory.Coverage}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,7,0,0" />
              <CheckBox x:Name="ExportInventoryCheck" Content="Uygulama kaydı ipuçlarını CSV'ye dahil et" IsChecked="{Binding Inventory.ExportHints}" IsEnabled="{Binding Inventory.HasSnapshot}" Margin="0,12,0,0" />
              <TextBlock Text="CSV seçeneği başlangıçta kapalıdır. Açılırsa yalnız rapordaki satır ilişkileri yazılır; tüm envanter dışa aktarılmaz. F6 Tam metni kopyala, görünen seçimin uygulama kaydı ipuçlarını da içerir." Style="{StaticResource MutedText}" FontSize="11" Margin="0,6,0,0" />
            </StackPanel></Border>
            <Border Style="{StaticResource Card}" Padding="23" Margin="0,0,0,14"><StackPanel IsEnabled="{Binding CanConfigure}">
              <TextBlock Text="Tarama hızı" FontSize="18" FontWeight="SemiBold" /><TextBlock Text="İşçi sayısı" Style="{StaticResource MutedText}" Margin="0,12,0,6" />
              <ComboBox x:Name="WorkerSelector" ItemsSource="{Binding WorkerChoices}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Workers}" MaxWidth="340" HorizontalAlignment="Left" MinWidth="270" AutomationProperties.Name="Tarama işçi sayısı" />
              <TextBlock Text="{Binding WorkerHint}" Style="{StaticResource MutedText}" Margin="0,12,0,0" />
              <TextBlock Text="Dönen diskte Otomatik veya tek işçiyle başlayın. Hız karşılaştırmasında aynı konumu kullanın; disk önbelleği ikinci koşuyu hızlandırabilir." Style="{StaticResource MutedText}" Margin="0,8,0,0" />
            </StackPanel></Border>
            <Border Style="{StaticResource Card}" Padding="23" Margin="0,0,0,14"><StackPanel IsEnabled="{Binding CanConfigure}">
              <TextBlock Text="Liste ve bellek" FontSize="18" FontWeight="SemiBold" /><TextBlock Text="Listede tutulan en büyük dosyalar" Style="{StaticResource MutedText}" Margin="0,12,0,6" />
              <ComboBox ItemsSource="{Binding LimitChoices}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding FileLimit}" MaxWidth="340" HorizontalAlignment="Left" MinWidth="270" AutomationProperties.Name="Dosya listesi sınırı" />
              <TextBlock Text="{Binding LimitHint}" Style="{StaticResource MutedText}" Margin="0,12,0,0" />
            </StackPanel></Border>
            <Border Style="{StaticResource Card}" Padding="23"><StackPanel>
              <TextBlock Text="Görünüm ve arama" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" />
              <Button Content="Koyu / açık temayı değiştir" Click="ToggleTheme" HorizontalAlignment="Left" Margin="0,4,0,8" />
              <CheckBox Content="Klasör aramasında tam yolu kullan" IsChecked="{Binding FullFolderPath}" Click="FolderFilterChanged" />
              <TextBlock Text="Varsayılan yalnız klasör adıdır. Tam yolda arama, üst klasörün adı geçtiği için çok sayıda alt klasörü eşleştirebilir. Dosya ve uyarı araması her zaman tam yolu kullanır." Style="{StaticResource MutedText}" />
              <CheckBox Content="Tam yol ve ek akış sütunlarını göster" IsChecked="{Binding TechnicalColumns}" Click="TechnicalChanged" Margin="0,15,0,8" />
              <TextBlock Text="Sade görünümde de tam yol ve ek akış bilgileri seçim ayrıntılarında ve CSV raporunda korunur." Style="{StaticResource MutedText}" />
              <Button Content="Varsayılanlara dön" Click="ResetSettings" HorizontalAlignment="Left" Margin="0,18,0,0" IsEnabled="{Binding CanConfigure}" />
            </StackPanel></Border>
          </StackPanel>
        </ScrollViewer>
      </Grid>
      <StackPanel Grid.Row="5" Margin="0,12,0,0"><ProgressBar Height="3" IsIndeterminate="{Binding IsBusy}" Maximum="1" Value="0" Foreground="{DynamicResource Accent}" Background="{DynamicResource Line}" BorderThickness="0" /><TextBlock Text="{Binding Status}" Foreground="{DynamicResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,9,0,0" ToolTip="{Binding ScopeText}" /></StackPanel>
    </Grid>
  </Grid>
</Window>
