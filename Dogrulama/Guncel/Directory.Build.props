<Project>
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>Exe</OutputType><PlatformTarget>x64</PlatformTarget>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors><EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <ValidationWorkDirectory Condition="'$(ValidationWorkDirectory)' == ''">$(MSBuildThisFileDirectory)Yerel-Derleme</ValidationWorkDirectory>
    <ProductDirectory Condition="'$(ProductDirectory)' == ''">$(MSBuildThisFileDirectory)../../Kaynak/Derleme</ProductDirectory>
    <BaseIntermediateOutputPath>$(ValidationWorkDirectory)/obj/$(MSBuildProjectName)/</BaseIntermediateOutputPath>
    <MSBuildProjectExtensionsPath>$(BaseIntermediateOutputPath)</MSBuildProjectExtensionsPath>
  </PropertyGroup>
</Project>
